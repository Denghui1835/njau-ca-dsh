{
  "name": "@njau-ca/dsh-njau-manju",
  "version": "0.1.0",
  "description": "计协工作坊 · 漫剧柱：剧本与分镜的编辑器，一条漫剧的全部工序都挂在 storyboard.json 上。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "manju",
    "comic",
    "storyboard",
    "plugin"
  ],
  "files": [
    "lib/",
    "client/",
    "cordis.patch.yml",
    "README.md",
    "OWNER.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
